# Heimdall environment template (committed).
#
# Copy to .env.local (gitignored) and fill with REAL values. The backend reads
# this file from the repo root. Do not put real secrets in THIS file.
#
# Where the values come from (run from the repo root):
#   terraform output -raw s3_bucket_name      -> S3_BUCKET_NAME
#   terraform output -raw db_endpoint         -> host:port of DATABASE_URL
#   terraform output -raw cognito_pool_id     -> COGNITO_USER_POOL_ID
#   terraform output -raw cognito_client_id   -> COGNITO_CLIENT_ID
#   aws bedrock list-inference-profiles --region us-east-1 \
#     --query "inferenceProfileSummaries[?contains(inferenceProfileId,'sonnet-4-6')].inferenceProfileId" \
#     --output text                           -> BEDROCK_MODEL_ID (use the us.* one)
# The DB password is in infra terraform.tfvars (treat as a secret).

# ===== AWS =====
AWS_REGION=us-east-1
S3_BUCKET_NAME=heimdall-documents-xxxxxxxx
KMS_KEY_ALIAS=alias/heimdall

# ===== Database (RDS Postgres) =====
# Format: postgresql+asyncpg://heimdall_admin:<DB_PASSWORD>@<db_endpoint>/heimdall
# (db_endpoint already includes the :5432 port)
DATABASE_URL=postgresql+asyncpg://heimdall_admin:CHANGE_ME@heimdall-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/heimdall

# ===== Auth (Cognito) =====
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# ===== Email (SES) =====
# Sender for the codes the API emails itself (authenticator recovery). Must be a
# verified SES identity; defaults shown. Leave unset to use them.
# MAIL_FROM=Heimdall <no-reply@heimdallclaims.com>
# MAIL_REPLY_TO=info@heimdallclaims.com

# ===== Bedrock =====
# Inference profile id (NOT a bare model id). Must start with "us.".
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ===== Rate limiting (Redis) =====
# Backs the login throttle and API rate limits (app/core/rate_limit.py). Leave
# EMPTY for local dev: the limiter falls back to in-memory storage, which is
# correct for a single process. MUST be set in production — in-memory counters
# are per-container, so with more than one task the login throttle is divided by
# the task count, and every deploy resets it.
# Production uses rediss:// — transit encryption is enforced on the cluster.
REDIS_URL=
# ElastiCache AUTH token, from Secrets Manager (heimdall/redis-auth-token). Kept
# out of REDIS_URL so it never sits in the ECS task definition's plaintext
# environment; config.redis_dsn() splices it in at connect time. Empty locally.
REDIS_AUTH_TOKEN=

# Limits (moving-window). Overridable without a redeploy.
RATE_LIMIT_GENERAL=150/minute      # authenticated general API, per user
RATE_LIMIT_AUTH=10/15minutes       # login, per IP, fail-closed
RATE_LIMIT_PUBLIC=15/minute        # unauthenticated public endpoints, per IP
RATE_LIMIT_AI=15/minute;50/day     # Bedrock/Textract endpoints, per user

# ===== PHI hashing =====
# HMAC pepper for cases.member_id_hash and the corpus export's claim_ref
# (app/core/hashing.py). NOT optional in production: a bare SHA-256 of a short,
# structured, payer-prefixed identifier is exhaustible offline, so it is not a
# de-identification control under §164.514, and §164.514(c) requires a
# re-identification code not derived from the individual's own data.
# From Secrets Manager (heimdall/phi-hash-pepper). Empty locally -> member_id_hash
# is omitted (it has no readers) and the corpus export refuses to run.
# ROTATING THIS breaks linkage with previously exported corpora, by design.
PHI_HASH_PEPPER=

# ===== App =====
APP_ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
# SNS topic for "get started" lead notifications. Empty disables the notify.
LEADS_TOPIC_ARN=
# Path to the AWS RDS CA bundle, enabling verify-full DB TLS (cert + hostname).
# The container ships one at /app/rds-ca.pem; empty means require-TLS-without-
# verification, which is the local-dev default.
DB_SSL_CA_BUNDLE=
# Trusted proxy hops in front of the app (the ECS Express ALB = 1). The real
# client IP is read this many entries from the RIGHT of X-Forwarded-For; too high
# a value lets a client spoof its own IP and evade the per-IP login throttle.
TRUSTED_PROXY_HOPS=1
# Hard cap on PDF pages sent to pypdf/Textract. A compressed 25 MB PDF can hold
# tens of thousands of pages; extraction has no timeout and Textract bills per page.
MAX_DOCUMENT_PAGES=150
# Server-side idle timeout, in minutes. The browser's 15-minute timer is a UX
# affordance — a closed tab cancels it and leaves the session valid. 0 disables.
IDLE_TIMEOUT_MINUTES=15
